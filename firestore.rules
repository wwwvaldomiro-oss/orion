        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.odometer is int || data.odometer is float) && data.odometer >= 0
        && data.fuelType in ['GASOLINA', 'ETANOL', 'DIESEL', 'GNV', 'ELETRICO', 'FLEX']
        && (data.quantity is int || data.quantity is float) && data.quantity > 0
        && (data.unitPrice is int || data.unitPrice is float) && data.unitPrice > 0
        && (data.totalCost is int || data.totalCost is float) && data.totalCost > 0
        && data.fullTank is bool
        && (!('stationName' in data) || (data.stationName is string && data.stationName.size() <= 120))
        && (!('nfceKey' in data) || (data.nfceKey is string && data.nfceKey.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidGarageMaintenance(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'type', 'status', 'date', 'odometer',
          'category', 'partsCost', 'laborCost', 'totalCost', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'driverId', 'type', 'status', 'originChecklistId',
          'date', 'odometer', 'category', 'providerName', 'partsCost', 'laborCost',
          'totalCost', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128))
        && data.type in ['PREVENTIVA', 'CORRETIVA']
        && data.status in ['ABERTA', 'EM_EXECUCAO', 'CONCLUIDA']
        && (!('originChecklistId' in data) || (data.originChecklistId is string && data.originChecklistId.size() <= 128))
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.odometer is int || data.odometer is float) && data.odometer >= 0
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (!('providerName' in data) || (data.providerName is string && data.providerName.size() <= 120))
        && (data.partsCost is int || data.partsCost is float) && data.partsCost >= 0
        && (data.laborCost is int || data.laborCost is float) && data.laborCost >= 0
        && (data.totalCost is int || data.totalCost is float) && data.totalCost >= 0
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400));
    }

    function isValidGarageExpense(data, userId) {
      return data.keys().hasAll(['ownerId', 'vehicleId', 'category', 'date', 'amount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'driverId', 'category', 'date', 'amount',
          'description', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.amount is int || data.amount is float) && data.amount > 0
        && (!('description' in data) || (data.description is string && data.description.size() <= 240));
    }

    function isValidGarageFine(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'date', 'infractionCode', 'description',
          'points', 'amount', 'sneDiscountApplied', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'driverId', 'date', 'time', 'infractionCode',
          'description', 'location', 'points', 'amount', 'sneDiscountApplied',
          'driverIndicationDeadline', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128))
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('time' in data) || (data.time is string && data.time.size() <= 10))
        && data.infractionCode is string && data.infractionCode.size() >= 1 && data.infractionCode.size() <= 30
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && (!('location' in data) || (data.location is string && data.location.size() <= 160))
        && data.points is int && data.points >= 0 && data.points <= 21
        && (data.amount is int || data.amount is float) && data.amount > 0
        && data.sneDiscountApplied is bool
        && (!('driverIndicationDeadline' in data) || (data.driverIndicationDeadline is string && data.driverIndicationDeadline.size() <= 10))
        && data.status in ['PENDENTE', 'INDICADO', 'PAGA', 'RECORRIDA'];
    }

    function isValidGarageDocument(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'docType', 'referenceYear', 'dueDate',
          'amount', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'docType', 'referenceYear', 'dueDate', 'amount',
          'stateUf', 'providerOrAuthority', 'policyOrCode', 'status', 'paidAt',
          'autoGenerated', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && data.docType in ['CRLV', 'IPVA', 'SEGURO', 'VISTORIA']
        && data.referenceYear is int && data.referenceYear >= 2000 && data.referenceYear <= 2100
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.amount is int || data.amount is float) && data.amount >= 0
        && (!('stateUf' in data) || (data.stateUf is string && data.stateUf.size() <= 4))
        && (!('providerOrAuthority' in data) || (data.providerOrAuthority is string && data.providerOrAuthority.size() <= 120))
        && (!('policyOrCode' in data) || (data.policyOrCode is string && data.policyOrCode.size() <= 120))
        && data.status in ['PENDENTE', 'PAGO', 'ISENTO']
        && (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 10))
        && (!('autoGenerated' in data) || data.autoGenerated is bool)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidGarageChecklist(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'date', 'odometer', 'items', 'hasIssues', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'driverId', 'date', 'odometer', 'items',
          'hasIssues', 'generatedMaintenanceId', 'generalNotes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128))
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.odometer is int || data.odometer is float) && data.odometer >= 0
        && data.items is list
        && data.items.size() >= 1 && data.items.size() <= 25
        && data.items[0] is map
        && data.hasIssues is bool
        && (!('generatedMaintenanceId' in data) || (data.generatedMaintenanceId is string && data.generatedMaintenanceId.size() <= 128))
        && (!('generalNotes' in data) || (data.generalNotes is string && data.generalNotes.size() <= 400));
    }

    function isValidGarageRoute(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'date', 'origin', 'destination',
          'startOdometer', 'endOdometer', 'distanceKm', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'driverId', 'date', 'origin', 'destination',
          'startOdometer', 'endOdometer', 'distanceKm', 'estimatedKm', 'purpose',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128))
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 120
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 120
        && (data.startOdometer is int || data.startOdometer is float) && data.startOdometer >= 0
        && (data.endOdometer is int || data.endOdometer is float) && data.endOdometer >= data.startOdometer
        && (data.distanceKm is int || data.distanceKm is float) && data.distanceKm >= 0
        && (!('estimatedKm' in data) || ((data.estimatedKm is int || data.estimatedKm is float) && data.estimatedKm >= 0))
        && (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 160));
    }

    function isValidGarageReminder(data, userId) {
      return data.keys().hasAll(['ownerId', 'vehicleId', 'title', 'category', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'title', 'category', 'dueDate', 'dueOdometer',
          'completed', 'completedAt', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category in ['MANUTENCAO', 'DOCUMENTACAO', 'SEGURO', 'OUTRO']
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 10))
        && (!('dueOdometer' in data) || ((data.dueOdometer is int || data.dueOdometer is float) && data.dueOdometer >= 0))
        && data.completed is bool
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 10))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidFuelLog(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'vehicleId', 'date', 'liters', 'totalCents', 'odometerKm', 'fuelType', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'vehicleId', 'date', 'liters', 'totalCents', 'odometerKm', 'fuelType', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.vehicleId)
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.liters is int || data.liters is float) && data.liters > 0
        && data.totalCents is int && data.totalCents >= 0
        && (data.odometerKm is int || data.odometerKm is float) && data.odometerKm >= 0
        && data.fuelType in ['Gasolina', 'Etanol', 'Diesel'];
    }

    function isValidTripPlan(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'destination', 'startDate', 'endDate', 'budgetCents',
          'spentCents', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'destination', 'startDate', 'endDate', 'budgetCents',
          'spentCents', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 140
        && data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.budgetCents is int && data.budgetCents >= 0
        && data.spentCents is int && data.spentCents >= 0
        && data.notes is string && data.notes.size() <= 400
        && data.status in ['Planejada', 'Em curso', 'Concluída'];
    }

    function isValidFiscalReceipt(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'kind', 'store', 'issuedAt', 'totalCents', 'items', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'kind', 'docType', 'uf', 'store', 'cnpj', 'emitterAddress',
          'issuedAt', 'issuedTime', 'accessKey', 'number', 'series', 'paymentMethod',
          'discountCents', 'totalCents', 'items', 'archiveCategory', 'folderPath',
          'storagePath', 'fileName', 'fileMimeType', 'fileHash', 'documentUrl',
          'sourceUrl', 'linkedTransactionId', 'processingStatus', 'processingError',
          'sourceOrigin', 'lowConfidenceFields', 'warranty', 'sourceRecordId',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && data.kind in ['geral', 'mercado', 'aquisicoes']
        && (!('docType' in data) || data.docType in ['nfce_65', 'nfe_55', 'nfse', 'recibo'])
        && (!('uf' in data) || (data.uf is string && data.uf.size() <= 4))
        && data.store is string && data.store.size() >= 1 && data.store.size() <= 160
        && (!('cnpj' in data) || (data.cnpj is string && data.cnpj.size() <= 30))
        && (!('emitterAddress' in data) || (data.emitterAddress is string && data.emitterAddress.size() <= 220))
        && data.issuedAt is string && data.issuedAt.size() == 10 && data.issuedAt.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('issuedTime' in data) || (data.issuedTime is string && data.issuedTime.size() <= 10))
        && (!('accessKey' in data) || (data.accessKey is string && data.accessKey.size() <= 60))
        && (!('number' in data) || (data.number is string && data.number.size() <= 30))
        && (!('series' in data) || (data.series is string && data.series.size() <= 20))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80))
        && (!('discountCents' in data) || (data.discountCents is int && data.discountCents >= 0))
        && data.totalCents is int && data.totalCents >= 0
        && data.items is list && data.items.size() <= 150
        && (data.items.size() == 0 || data.items[0] is map)
        && (!('archiveCategory' in data) || (data.archiveCategory is string && data.archiveCategory.size() <= 60))
        && (!('folderPath' in data) || (data.folderPath is string && data.folderPath.size() <= 120))
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 400))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 160))
        && (!('fileMimeType' in data) || (data.fileMimeType is string && data.fileMimeType.size() <= 80))
        && (!('fileHash' in data) || (data.fileHash is string && data.fileHash.size() <= 80))
        && (!('documentUrl' in data) || (data.documentUrl is string && data.documentUrl.size() <= 1000))
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 1000))
        && (!('linkedTransactionId' in data) || (data.linkedTransactionId is string && data.linkedTransactionId.size() <= 128))
        && (!('processingStatus' in data) || data.processingStatus in ['complete', 'partial', 'pending', 'error'])
        && (!('processingError' in data) || (data.processingError is string && data.processingError.size() <= 300))
        && (!('sourceOrigin' in data) || data.sourceOrigin in ['manual', 'qr', 'url', 'xml', 'ocr', 'import'])
        && (!('lowConfidenceFields' in data) || (data.lowConfidenceFields is list && data.lowConfidenceFields.size() <= 20))
        && (!('warranty' in data) || data.warranty is map)
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidLoyaltyHolder(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'relationship', 'cpfMasked', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'relationship', 'cpfMasked', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.relationship in ['Titular', 'Cônjuge', 'Filho(a)', 'Familiar', 'Amigo', 'Outro']
        && data.cpfMasked is string && data.cpfMasked.size() <= 20
        && data.notes is string && data.notes.size() <= 200;
    }

    function isValidLoyaltyAccount(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'holderId', 'holderName', 'programId', 'programName', 'category',
          'accountNumber', 'tier', 'balance', 'expiringPoints', 'expirationDate',
          'avgCpm', 'cpfsUsed', 'cpfLimit', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'holderId', 'holderName', 'programId', 'programName', 'category',
          'accountNumber', 'tier', 'balance', 'expiringPoints', 'expirationDate',
          'avgCpm', 'cpfsUsed', 'cpfLimit', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.holderId)
        && data.holderName is string && data.holderName.size() >= 1 && data.holderName.size() <= 80
        && data.programId is string && data.programId.size() >= 1 && data.programId.size() <= 40
        && data.programName is string && data.programName.size() >= 1 && data.programName.size() <= 60
        && data.category in ['aerea', 'banco', 'varejo']
        && data.accountNumber is string && data.accountNumber.size() <= 40
        && data.tier is string && data.tier.size() <= 40
        && data.balance is int && data.balance >= 0
        && data.expiringPoints is int && data.expiringPoints >= 0
        && data.expirationDate is string && data.expirationDate.size() <= 20
        && (data.avgCpm is int || data.avgCpm is float) && data.avgCpm >= 0
        && data.cpfsUsed is int && data.cpfsUsed >= 0 && data.cpfsUsed <= 50
        && data.cpfLimit is int && data.cpfLimit >= 0 && data.cpfLimit <= 50;
    }

    function isValidPointTransaction(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'accountId', 'programName', 'holderName', 'type', 'points',
          'description', 'date', 'cpm', 'totalBrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'accountId', 'programName', 'holderName', 'type', 'points',
          'description', 'date', 'cpm', 'totalBrl', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.accountId)
        && data.programName is string && data.programName.size() >= 1 && data.programName.size() <= 60
        && data.holderName is string && data.holderName.size() >= 1 && data.holderName.size() <= 80
        && data.type in ['acumulo', 'resgate', 'transferencia_entrada', 'transferencia_saida', 'venda', 'expiracao', 'ajuste']
        && data.points is int
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 140
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && (data.cpm is int || data.cpm is float) && data.cpm >= 0
        && (data.totalBrl is int || data.totalBrl is float) && data.totalBrl >= 0;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && hasValidTimestampsOnCreate(incoming())
        && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && hasImmutableCoreOnUpdate()
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'photoUrl', 'city', 'state', 'pixRecipient', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['selectedLogoId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['watchlistTickers', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'photoUrl', 'city', 'state', 'selectedLogoId', 'pixRecipient', 'watchlistTickers', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Family budget forecasts are isolated from payable obligations and wallet balances.
      match /budgetYears/{budgetYearId} {
        allow get: if isValidId(userId) && isOwner(userId) && parentWorkspaceOwned(userId)
          && budgetYearId.matches('^20[0-9]{2} (never readable/writable from browser)
      match /pluggySettings/{slotId} {
        allow read, write: if false;
      }

      match /fiscalReceipts/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && parentWorkspaceOwned(userId);
        allow list: if isOwner(userId) && parentWorkspaceOwned(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && parentWorkspaceOwned(userId)
          && hasValidTimestampsOnCreate(incoming())
          && isValidFiscalReceipt(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && parentWorkspaceOwned(userId)
          && hasImmutableCoreOnUpdate()
          && isValidFiscalReceipt(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'kind', 'docType', 'uf', 'store', 'cnpj', 'emitterAddress',
            'issuedAt', 'issuedTime', 'accessKey', 'number', 'series', 'paymentMethod',
            'discountCents', 'totalCents', 'items', 'archiveCategory', 'folderPath',
            'storagePath', 'fileName', 'fileMimeType', 'fileHash', 'documentUrl',
            'sourceUrl', 'linkedTransactionId', 'processingStatus', 'processingError',
            'sourceOrigin', 'lowConfidenceFields', 'warranty', 'sourceRecordId', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && parentWorkspaceOwned(userId);
      }

      match /banks/{bankId} {
        allow get: if isValidId(userId) && isValidId(bankId) && isOwner(userId) && parentWorkspaceOwned(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(bankId) && isOwner(userId)
          && hasValidTimestampsOnCreate(incoming())
          && isValidBankAccount(incoming(), userId)
          && parentWorkspaceOwned(userId);
        allow update: if isValidId(userId) && isValidId(bankId) && isOwner(userId)
          && isValidBankAccount(incoming(), userId)
          && hasImmutableCoreOnUpdate()
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['balanceCents', 'name', 'institution', 'color', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['institution', 'name', 'accountType', 'number', 'balanceCents', 'color', 'sourceRecordId', 'updatedAt'])
          )
          && parentWorkspaceOwned(userId);
        allow delete: if isValidId(userId) && isValidId(bankId) && isOwner(userId) && parentWorkspaceOwned(userId);
      }

      match /cards/{cardId} {
        allow get: if isValidId(userId) && isValidId(cardId) && isOwner(userId) && parentWorkspaceOwned(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(cardId) && isOwner(userId)
          && hasValidTimestampsOnCreate(incoming())
          && isValidCreditCard(incoming(), userId)
          && parentWorkspaceOwned(userId);
        allow update: if isValidId(userId) && isValidId(cardId) && isOwner(userId)
          && isValidCreditCard(incoming(), userId)
          && hasImmutableCoreOnUpdate()
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['manualLimitCents', 'manualUsedCents', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['creditLimitCents', 'availableCents', 'closingDay', 'dueDay', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['institution', 'name', 'brand', 'number', 'creditLimitCents', 'availableCents', 'closingDay', 'dueDay', 'linkedAnnualExpenseId', 'sourceRecordId', 'updatedAt'])
          )
          && parentWorkspaceOwned(userId);
        allow delete: if isValidId(userId) && isValidId(cardId) && isOwner(userId) && parentWorkspaceOwned(userId);
      }

      match /cardMonthSnapshots/{snapshotId} {
        allow get: if isValidId(userId) && isValidId(snapshotId) && isOwner(userId) && parentWorkspaceOwned(userId);
