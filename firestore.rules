rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidTimestampsOnCreate(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasImmutableCoreOnUpdate() {
      return incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt is timestamp
        && incoming().updatedAt == request.time;
    }

    function isValidBudgetYear(data, userId, budgetYearId) {
      return data.keys().hasAll(['ownerId', 'year', 'createdAt', 'updatedAt', 'categories', 'rows', 'goals'])
        && data.keys().hasOnly(['ownerId', 'year', 'createdAt', 'updatedAt', 'categories', 'rows', 'goals'])
        && data.ownerId == userId
        && data.year is int && data.year >= 2000 && data.year <= 2099
        && budgetYearId == string(data.year)
        && data.categories is list && data.categories.size() <= 150
        && data.rows is list && data.rows.size() <= 250
        && data.goals is list && data.goals.size() <= 100
        && (data.categories.size() == 0 || (
          data.categories[0] is map &&
          data.categories[0].keys().hasAll(['id', 'name', 'parentId']) &&
          data.categories[0].id is string && data.categories[0].name is string
        ))
        && (data.rows.size() == 0 || (
          data.rows[0] is map &&
          data.rows[0].keys().hasAll(['id', 'title', 'categoryId', 'months', 'sourceAnnualId']) &&
          data.rows[0].months is list && data.rows[0].months.size() == 12
        ))
        && (data.goals.size() == 0 || (
          data.goals[0] is map &&
          data.goals[0].keys().hasAll(['id', 'title', 'kind', 'targetCents', 'savedCents', 'targetDate', 'contributions']) &&
          data.goals[0].targetCents is int && data.goals[0].targetCents > 0 &&
          data.goals[0].contributions is list && data.goals[0].contributions.size() == 12
        ));
    }

    // Pillar 1: Master Gate parent check for user subcollections
    function parentWorkspaceOwned(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // --- Validation Blueprints (Pillar 2) ---

    function isValidPixRecipient(pix) {
      return pix is map
        && pix.keys().hasAll(['key', 'name', 'state', 'city'])
        && pix.keys().hasOnly(['key', 'name', 'state', 'city'])
        && pix.key is string && pix.key.size() <= 160
        && pix.name is string && pix.name.size() <= 120
        && pix.state is string && pix.state.size() <= 4
        && pix.city is string && pix.city.size() <= 100;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'email', 'photoUrl', 'city', 'state',
          'selectedLogoId', 'pixRecipient', 'watchlistTickers', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'email', 'photoUrl', 'city', 'state',
          'selectedLogoId', 'pixRecipient', 'watchlistTickers', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.city is string && data.city.size() <= 100
        && data.state is string && data.state.size() <= 4
        && data.selectedLogoId is string
        && data.selectedLogoId in ['nexo', 'apice', 'prisma', 'vortice', 'orbita']
        && isValidPixRecipient(data.pixRecipient)
        && data.watchlistTickers is list
        && data.watchlistTickers.size() <= 50
        && (data.watchlistTickers.size() == 0 || (data.watchlistTickers[0] is string && data.watchlistTickers[0].size() <= 16));
    }

    function isValidBankAccount(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'institution', 'name', 'accountType', 'number', 'balanceCents', 'color', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'institution', 'name', 'accountType', 'number', 'balanceCents', 'color',
          'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.institution is string && data.institution.size() >= 1 && data.institution.size() <= 80
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.accountType in ['CHECKING', 'SAVINGS']
        && data.number is string && data.number.size() >= 1 && data.number.size() <= 20
        && data.balanceCents is int
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 20
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidCreditCard(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'institution', 'name', 'brand', 'number', 'creditLimitCents',
          'availableCents', 'closingDay', 'dueDay', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'institution', 'name', 'brand', 'number', 'creditLimitCents',
          'availableCents', 'closingDay', 'dueDay', 'manualLimitCents', 'manualUsedCents',
          'linkedAnnualExpenseId', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.institution is string && data.institution.size() >= 1 && data.institution.size() <= 80
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.brand in ['VISA', 'MASTERCARD', 'ELO', 'AMEX', 'HIPERCARD', 'OTHER']
        && data.number is string && data.number.size() >= 1 && data.number.size() <= 10
        && data.creditLimitCents is int && data.creditLimitCents >= 0
        && data.availableCents is int
        && data.closingDay is int && data.closingDay >= 1 && data.closingDay <= 31
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && (!('manualLimitCents' in data) || (data.manualLimitCents is int && data.manualLimitCents >= 0))
        && (!('manualUsedCents' in data) || (data.manualUsedCents is int && data.manualUsedCents >= 0))
        && (!('linkedAnnualExpenseId' in data) || (data.linkedAnnualExpenseId is string && data.linkedAnnualExpenseId.size() <= 128))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidWalletTransaction(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'accountId', 'accountType', 'accountName', 'institution',
          'description', 'amountCents', 'date', 'category', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'accountId', 'accountType', 'accountName', 'institution',
          'description', 'amountCents', 'date', 'category', 'reconciledEventId',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.accountId is string && data.accountId.size() <= 128
        && data.accountType in ['BANK', 'CREDIT']
        && data.accountName is string && data.accountName.size() <= 100
        && data.institution is string && data.institution.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 160
        && data.amountCents is int
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.category is string && data.category.size() <= 60
        && (!('reconciledEventId' in data) || data.reconciledEventId == null || (data.reconciledEventId is string && data.reconciledEventId.size() <= 128));
    }

    function isValidRevenueSource(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'category', 'expectedCents', 'dueDay', 'recurrence', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'category', 'expectedCents', 'dueDay', 'recurrence', 'active',
          'firstDue', 'details', 'note', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category is string && data.category.size() <= 60
        && data.expectedCents is int && data.expectedCents > 0
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && data.recurrence in ['monthly', 'single']
        && data.active is bool
        && (!('firstDue' in data) || (data.firstDue is string && data.firstDue.size() <= 10))
        && (!('details' in data) || (data.details is string && data.details.size() <= 400))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidRevenueContract(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'buyer', 'cpf', 'phone', 'email', 'city', 'state', 'address',
          'postalCode', 'totalCents', 'downPaymentCents', 'interestPercent', 'finePercent',
          'correctionIndex', 'status', 'contractDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'buyer', 'cpf', 'phone', 'email', 'city', 'state', 'address',
          'postalCode', 'totalCents', 'downPaymentCents', 'interestPercent', 'finePercent',
          'correctionIndex', 'customRatePercent', 'status', 'contractDate', 'note', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.buyer is string && data.buyer.size() >= 1 && data.buyer.size() <= 140
        && data.cpf is string && data.cpf.size() <= 30
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 140
        && data.city is string && data.city.size() <= 100
        && data.state is string && data.state.size() <= 4
        && data.address is string && data.address.size() <= 200
        && data.postalCode is string && data.postalCode.size() <= 20
        && data.totalCents is int && data.totalCents > 0
        && data.downPaymentCents is int && data.downPaymentCents >= 0
        && (data.interestPercent is int || data.interestPercent is float)
        && (data.finePercent is int || data.finePercent is float)
        && data.correctionIndex in ['Sem correção', 'IPCA', 'IGP-M', 'Personalizado']
        && (!('customRatePercent' in data) || (data.customRatePercent is int || data.customRatePercent is float))
        && data.status in ['Em andamento', 'Atrasado', 'Concluído', 'Pausado', 'Perdoado', 'Ajuizado', 'Renegociado']
        && data.contractDate is string && data.contractDate.size() == 10
        && (!('note' in data) || (data.note is string && data.note.size() <= 300));
    }

    function isValidRevenueEntry(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'category', 'dueDate', 'expectedCents',
          'receivedDate', 'receivedCents', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'sourceId', 'contractId', 'installmentNumber', 'title', 'category',
          'dueDate', 'expectedCents', 'receivedDate', 'receivedCents', 'agreedCents',
          'adjustmentCents', 'discountCents', 'surchargeCents', 'accountId',
          'bankTransactionId', 'attachments', 'note', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && (!('sourceId' in data) || (data.sourceId is string && data.sourceId.size() <= 128))
        && (!('contractId' in data) || (data.contractId is string && data.contractId.size() <= 128))
        && (!('installmentNumber' in data) || (data.installmentNumber is int && data.installmentNumber >= 1))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() <= 60
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.expectedCents is int && data.expectedCents > 0
        && (data.receivedDate == null || (data.receivedDate is string && data.receivedDate.size() == 10))
        && (data.receivedCents == null || (data.receivedCents is int && data.receivedCents >= 0))
        && (!('agreedCents' in data) || (data.agreedCents is int && data.agreedCents >= 0))
        && (!('adjustmentCents' in data) || data.adjustmentCents == null || data.adjustmentCents is int)
        && (!('discountCents' in data) || data.discountCents == null || (data.discountCents is int && data.discountCents >= 0))
        && (!('surchargeCents' in data) || data.surchargeCents == null || (data.surchargeCents is int && data.surchargeCents >= 0))
        && (!('accountId' in data) || data.accountId == null || (data.accountId is string && data.accountId.size() <= 128))
        && (!('bankTransactionId' in data) || data.bankTransactionId == null || (data.bankTransactionId is string && data.bankTransactionId.size() <= 128))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20 && (data.attachments.size() == 0 || data.attachments[0] is map)))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidRevenueEvent(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'entryId', 'kind', 'reason', 'eventCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'entryId', 'kind', 'reason', 'eventCreatedAt',
          'accountId', 'bankTransactionId', 'targetEventId', 'idempotencyKey',
          'beforeData', 'afterData', 'attachments', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.entryId is string && data.entryId.size() >= 1 && data.entryId.size() <= 128
        && data.kind is string && data.kind.size() >= 1 && data.kind.size() <= 40
        && data.reason is string && data.reason.size() <= 300
        && data.eventCreatedAt is string && data.eventCreatedAt.size() <= 40
        && (!('accountId' in data) || data.accountId == null || (data.accountId is string && data.accountId.size() <= 128))
        && (!('bankTransactionId' in data) || data.bankTransactionId == null || (data.bankTransactionId is string && data.bankTransactionId.size() <= 128))
        && (!('targetEventId' in data) || data.targetEventId == null || (data.targetEventId is string && data.targetEventId.size() <= 128))
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && (!('beforeData' in data) || data.beforeData == null || data.beforeData is map)
        && (!('afterData' in data) || data.afterData == null || data.afterData is map)
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20 && (data.attachments.size() == 0 || data.attachments[0] is map)))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidAnnualYearRecord(data, userId) {
      return data.keys().hasAll(['ownerId', 'year', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'year', 'sourceName', 'archivedAt',
          'totalExpenseCents', 'categoryTotalsCents', 'monthlyCategoryCents', 'snapshotUpdatedAt',
          'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.year is int && data.year >= 2000 && data.year <= 2100
        && (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 140))
        && (!('archivedAt' in data) || data.archivedAt == null || (data.archivedAt is string && data.archivedAt.size() <= 40))
        && (!('totalExpenseCents' in data) || (data.totalExpenseCents is int && data.totalExpenseCents >= 0))
        && (!('categoryTotalsCents' in data) || data.categoryTotalsCents is map)
        && (!('monthlyCategoryCents' in data) || data.monthlyCategoryCents is map)
        && (!('snapshotUpdatedAt' in data) || (data.snapshotUpdatedAt is string && data.snapshotUpdatedAt.size() <= 40))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidAnnualExpenseRow(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'year', 'creditor', 'category', 'dueDay', 'months', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'year', 'creditor', 'category', 'dueDay', 'months',
          'expenseKind', 'expenseSource', 'annualTaxKind', 'consumptionValueType',
          'position', 'sourceContractId', 'sourceTemplateId', 'sourceRecordId',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.year is int && data.year >= 2000 && data.year <= 2100
        && data.creditor is string && data.creditor.size() >= 1 && data.creditor.size() <= 140
        && data.category is string && data.category.size() <= 60
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && data.months is map
        && data.months.size() <= 12
        && data.months.keys().hasOnly(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'])
        && (!('expenseKind' in data) || data.expenseKind in ['consumption', 'debt'])
        && (!('expenseSource' in data) || data.expenseSource in ['consumption', 'contract', 'card', 'annual_tax'])
        && (!('annualTaxKind' in data) || data.annualTaxKind == null || (data.annualTaxKind is string && data.annualTaxKind.size() <= 30))
        && (!('consumptionValueType' in data) || data.consumptionValueType == null || (data.consumptionValueType is string && data.consumptionValueType.size() <= 30))
        && (!('position' in data) || data.position is int)
        && (!('sourceContractId' in data) || data.sourceContractId == null || (data.sourceContractId is string && data.sourceContractId.size() <= 128))
        && (!('sourceTemplateId' in data) || data.sourceTemplateId == null || (data.sourceTemplateId is string && data.sourceTemplateId.size() <= 128))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidMonthlyBill(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'period', 'creditor', 'category', 'dueDate', 'expectedCents',
          'paidDate', 'paidCents', 'isSettled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'period', 'creditor', 'category', 'description', 'dueDate', 'expectedCents',
          'paidDate', 'paidCents', 'isSettled', 'sourceAnnualId', 'contractId',
          'installmentNumber', 'expenseKind', 'accountId', 'bankTransactionId',
          'discountCents', 'surchargeCents', 'attachments', 'isCardInvoice', 'cardId',
          'note', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.period is string && data.period.size() == 7 && data.period.matches('^\\d{4}-\\d{2}$')
        && data.creditor is string && data.creditor.size() >= 1 && data.creditor.size() <= 140
        && data.category is string && data.category.size() <= 60
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.expectedCents is int && data.expectedCents >= 0
        && (data.paidDate == null || (data.paidDate is string && data.paidDate.size() == 10))
        && (data.paidCents == null || (data.paidCents is int && data.paidCents >= 0))
        && data.isSettled is bool
        && (!('sourceAnnualId' in data) || (data.sourceAnnualId is string && data.sourceAnnualId.size() <= 128))
        && (!('contractId' in data) || data.contractId == null || (data.contractId is string && data.contractId.size() <= 128))
        && (!('installmentNumber' in data) || data.installmentNumber == null || (data.installmentNumber is int && data.installmentNumber >= 0))
        && (!('expenseKind' in data) || data.expenseKind in ['consumption', 'debt'])
        && (!('accountId' in data) || data.accountId == null || (data.accountId is string && data.accountId.size() <= 128))
        && (!('bankTransactionId' in data) || data.bankTransactionId == null || (data.bankTransactionId is string && data.bankTransactionId.size() <= 128))
        && (!('discountCents' in data) || data.discountCents == null || (data.discountCents is int && data.discountCents >= 0))
        && (!('surchargeCents' in data) || data.surchargeCents == null || (data.surchargeCents is int && data.surchargeCents >= 0))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20 && (data.attachments.size() == 0 || data.attachments[0] is map)))
        && (!('isCardInvoice' in data) || data.isCardInvoice is bool)
        && (!('cardId' in data) || data.cardId == null || (data.cardId is string && data.cardId.size() <= 128))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 128));
    }

    function isValidPaymentEvent(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'creditor', 'dueDate', 'expectedCents', 'paidCents', 'paidDate',
          'isSettled', 'kind', 'reason', 'eventCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'billId', 'installmentId', 'contractId', 'annualRowId', 'period', 'cardId',
          'creditor', 'category', 'dueDate', 'expectedCents', 'paidCents', 'paidDate',
          'discountCents', 'surchargeCents', 'isSettled', 'accountId', 'bankTransactionId',
          'targetEventId', 'idempotencyKey', 'kind', 'reason', 'eventCreatedAt',
          'beforeData', 'afterData', 'attachments', 'note', 'sourceRecordId', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && (!('billId' in data) || data.billId == null || (data.billId is string && data.billId.size() <= 128))
        && (!('installmentId' in data) || data.installmentId == null || (data.installmentId is string && data.installmentId.size() <= 128))
        && (!('contractId' in data) || data.contractId == null || (data.contractId is string && data.contractId.size() <= 128))
        && (!('annualRowId' in data) || data.annualRowId == null || (data.annualRowId is string && data.annualRowId.size() <= 128))
        && (!('period' in data) || data.period == null || (data.period is string && data.period.size() <= 7))
        && (!('cardId' in data) || data.cardId == null || (data.cardId is string && data.cardId.size() <= 128))
        && data.creditor is string && data.creditor.size() >= 1 && data.creditor.size() <= 140
        && (!('category' in data) || (data.category is string && data.category.size() <= 60))
        && data.dueDate is string && data.dueDate.size() <= 10
        && data.expectedCents is int && data.expectedCents >= 0
        && data.paidCents is int && data.paidCents >= 0
        && (data.paidDate == null || (data.paidDate is string && data.paidDate.size() == 10))
        && (!('discountCents' in data) || data.discountCents == null || (data.discountCents is int && data.discountCents >= 0))
        && (!('surchargeCents' in data) || data.surchargeCents == null || (data.surchargeCents is int && data.surchargeCents >= 0))
        && data.isSettled is bool
        && (!('accountId' in data) || data.accountId == null || (data.accountId is string && data.accountId.size() <= 128))
        && (!('bankTransactionId' in data) || data.bankTransactionId == null || (data.bankTransactionId is string && data.bankTransactionId.size() <= 128))
        && (!('targetEventId' in data) || data.targetEventId == null || (data.targetEventId is string && data.targetEventId.size() <= 128))
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && data.kind in ['pagamento', 'parcial', 'quitacao_antecipada', 'correcao', 'estorno']
